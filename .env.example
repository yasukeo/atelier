# Copy to .env and fill in. Never commit the real .env.

# PostgreSQL (Supabase: Session pooler on port 5432 for both in production)
DATABASE_URL="postgresql://postgres:password@localhost:5432/elwarcha"
DIRECT_URL="postgresql://postgres:password@localhost:5432/elwarcha"

# NextAuth — generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Cloudinary (optional locally: without it, admin uploads are saved to public/paintings/)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Resend (optional locally: without it, emails are skipped and logged to the console)
RESEND_API_KEY=""
EMAIL_FROM="Elwarcha <contact@elwarcha.com>"
CONTACT_EMAIL="contact@elwarcha.com"

# Admin account created by `npm run prisma:seed`
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-me"
